# Copiá este archivo a .env y completá TODO. docker compose se niega a
# arrancar si falta alguna variable obligatoria.

# Dominio público del viewer. Necesita un registro DNS A (y/o AAAA) apuntando
# al VPS ANTES del primer arranque, para que Caddy saque el certificado.
DOMAIN=watchando.blucaro.site

# Email para Let's Encrypt (avisos de expiración).
ACME_EMAIL=you@example.com

# IP pública del VPS: es lo que MediaMTX anuncia como candidato ICE.
# Preferí la IPv4 literal; un hostname también funciona (MediaMTX lo resuelve),
# pero si tiene AAAA y el VPS no tiene IPv6 bien ruteado, mete ruido.
PUBLIC_HOST=203.0.113.10

# Usuario y contraseña del PUBLISHER (lo que va en OBS como Bearer Token
# "PUBLISH_USER:PUBLISH_PASS"). Solo puede publicar, no leer.
# Caracteres permitidos: A-Z a-z 0-9 ! $ ( ) * + . ; < = > [ ] ^ _ - { } @ # &
# (sin ":"). Generala con:  openssl rand -hex 24
PUBLISH_USER=publisher
PUBLISH_PASS=

# Los amigos entran con usuario y contraseña propios: se crean con
#   scripts/amigos.sh agregar <nombre>
# (no van en este archivo; se guardan hasheados en viewers.env).

# OPCIONAL: link compartido sin login (https://DOMAIN/?r=<sala>&t=<token>).
# Cualquiera que tenga el link entra, así que se puede reenviar: por eso está
# apagado por defecto. Para activarlo:  openssl rand -hex 16
# Para revocarlo: borralo o cambialo y corré `docker compose up -d`.
VIEWER_TOKEN=

# Subred interna de Docker donde viven Caddy y MediaMTX. MediaMTX confía en el
# X-Forwarded-For que viene de esta subred. Cambiala solo si choca con otra red.
EDGE_SUBNET=172.30.80.0/24

# Nivel de log de MediaMTX: error | warn | info | debug
LOG_LEVEL=info

# Fallback RTMP (opcional, sin cifrar). Descomentá para activarlo:
#COMPOSE_FILE=docker-compose.yml:docker-compose.rtmp.yml
